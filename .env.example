# ─── Portal connection ──────────────────────────────────────────────────────
PORTAL_URL=https://portail.collegeblondin.qc.ca/pednet
PORTAL_LOGIN_PATH=/login.coba
PORTAL_NOTES_PATH=/notes.coba

PORTAL_USERNAME=your_username
PORTAL_PASSWORD=your_password

# ─── CSS selectors — login form ──────────────────────────────────────────────
SELECTOR_USERNAME_INPUT=input[name$='txtCodeUsager']
SELECTOR_PASSWORD_INPUT=input[name$='txtMotDePasse']
SELECTOR_LOGIN_BUTTON=button[type='submit']

# Optional: a CSS selector for an element that only appears when logged in.
# If set, the scraper waits for this element to confirm login succeeded.
SELECTOR_LOGIN_SUCCESS=

# ─── CSS selectors — notes page ──────────────────────────────────────────────
# SELECTOR_NOTE_CONTAINER  → the repeating element wrapping each note
# SELECTOR_NOTE_TITLE      → inside the container, the note title element
# SELECTOR_NOTE_BODY       → inside the container, the note body/content element
# SELECTOR_NOTE_DATE       → inside the container, the date element (leave empty to skip)
SELECTOR_NOTE_CONTAINER=div.note-card
SELECTOR_NOTE_TITLE=h2.note-title
SELECTOR_NOTE_BODY=p.note-body
SELECTOR_NOTE_DATE=span.note-date

# ─── Scraper behaviour ───────────────────────────────────────────────────────
# How long (seconds) to reuse a portal session before re-logging in
SESSION_TTL_SECONDS=600

# Set to false to watch the browser navigate (useful for debugging selectors)
PLAYWRIGHT_HEADLESS=true

# Max ms to wait for page loads and element selectors
PLAYWRIGHT_TIMEOUT_MS=10000
