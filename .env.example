# ─── Portal connection ──────────────────────────────────────────────────────
PORTAL_URL=https://portail.collegeblondin.qc.ca/pednet
PORTAL_LOGIN_PATH=/login.coba

# Les identifiants ne sont plus dans .env — ils sont fournis par le client
# via HTTP Basic Auth sur chaque requête.

# ─── CSS selectors — login form ──────────────────────────────────────────────
# The portal generates a random prefix on each session — ends-with selector handles this
SELECTOR_USERNAME_INPUT=input[name$='txtCodeUsager']
SELECTOR_PASSWORD_INPUT=input[name$='txtMotDePasse']
SELECTOR_LOGIN_BUTTON=button[type='submit']

# ─── CSS selectors — TRAVAUX data extraction ─────────────────────────────────
SELECTOR_COURSE_BLOCK=div.tableres
SELECTOR_COURSE_NAME=h4
SELECTOR_ASSIGNMENT_ROW=tr.grid3__row

# ─── Scraper behaviour ───────────────────────────────────────────────────────
SESSION_TTL_SECONDS=600
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=15000
